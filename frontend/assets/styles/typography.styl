h1, main > p
  margin: 0 0 0.5rem
  text-align: center

h1
  margin: 0
  font-size: 2rem
  font-weight: 400
  line-height: 1.1

h2
  font-size: 1.1rem
  font-weight: 400
  line-height: 1

main h2
  margin: -1rem -1rem 1rem
  padding: 0.75rem 1rem
  border-radius: var(--rounding) var(--rounding) 0 0
  background: var(--heading-background)
  color: var(--heading-text)

h3
  margin: 2rem 0 1rem
  padding: 0
  font-size: 1rem
  font-weight: 300
  text-align: center

h3:first-of-type
  margin-top: 0
